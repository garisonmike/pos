# Copy this file to .env before the first `docker compose up`.
#
#   cp .env.example .env
#
# The defaults below are safe for local development only. Every secret must be
# replaced before this is deployed anywhere a real business can reach it.

# --- Postgres bootstrap ------------------------------------------------------
# POSTGRES_USER is a superuser and is used only to create the database and the
# application role. Django never connects with it, because a superuser silently
# bypasses Row-Level Security and would defeat tenant isolation entirely.
POSTGRES_USER=pos_admin
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=pos

# --- Application database role ----------------------------------------------
# This is the role Django connects with. It is deliberately NOSUPERUSER and
# NOBYPASSRLS so that Row-Level Security applies to it without exception.
DB_USER=pos_app
DB_PASSWORD=change-me-in-production
DB_NAME=pos
DB_HOST=db
DB_PORT=5432

# --- Django ------------------------------------------------------------------
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=insecure-development-key-change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# --- Redis -------------------------------------------------------------------
# Holds the per-business active/suspended status and the failed-PIN counters
# behind till lockout. Nothing here is persisted; losing it on a restart costs
# one extra query per business and forgives any attempt counters mid-flight.
REDIS_URL=redis://cache:6379/0

# --- Authentication ----------------------------------------------------------
# Access tokens are short-lived; refresh tokens last long enough that a till
# left running over a weekend does not force a re-login on Monday morning.
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=14

# Till PIN lockout. A four-digit PIN is only usable because it is half a
# credential - the other half is a registered device - but without a limit it is
# still guessable in ten thousand tries. After this many consecutive failures on
# one device, that device is refused for the lockout period.
PIN_LOCKOUT_MAX_ATTEMPTS=5
PIN_LOCKOUT_SECONDS=900

# --- M-Pesa ------------------------------------------------------------------
# Encrypts each tenant's Daraja credentials at rest. Deliberately NOT the Django
# secret key: that gets rotated for its own reasons, and rotating it must not
# destroy every tenant's payment configuration. Generate your own with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DARAJA_ENCRYPTION_KEY=4-DCLBj8VmPuZq3bRImmdBntxGsLjFl_ioP5pxiu6fQ

# Where Safaricom posts STK results. Must be publicly reachable in a real
# deployment; point it at an ngrok URL to try the sandbox from a laptop.
MPESA_CALLBACK_BASE_URL=http://localhost:8000

# How many proxies of yours sit in front of Django. 1 for a single nginx, Caddy
# or load balancer terminating TLS; 0 when nothing is in front.
#
# It decides which X-Forwarded-For entry the M-Pesa callback allowlist believes.
# The LAST entry is the one your own proxy appended; everything before it is
# whatever the caller sent. Production refuses to start until this is set, since
# guessing too low lets a forged callback through and too high refuses every
# real one.
TRUSTED_PROXY_HOPS=0

# --- Platform admin ----------------------------------------------------------
# The Django admin is mounted at this path. It is deliberately not "admin/" so
# that the platform control surface is not discoverable by scanning.
PLATFORM_ADMIN_URL=ops-console-8f31c2/

# Seeded on first boot so there is a way in on a fresh machine.
PLATFORM_ADMIN_USERNAME=platform
PLATFORM_ADMIN_PASSWORD=change-me-in-production
PLATFORM_ADMIN_EMAIL=admin@example.com

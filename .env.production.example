# Production environment.
#
#   cp .env.production.example .env.production
#   # fill in every value marked CHANGE ME
#   docker compose --env-file .env.production \
#     -f docker-compose.yml -f docker-compose.prod.yml up -d
#
# Nothing in this file is a secret. The file you make from it is entirely
# secrets - keep it off the repository, off chat, and readable only by the
# user that runs docker.

# ---------------------------------------------------------------------------
# Where this instance lives
# ---------------------------------------------------------------------------

# The domain Caddy answers on and requests a certificate for. One name, no
# scheme, no trailing slash.
DOMAIN=pos.example.co.ke                                   # CHANGE ME

# Where Let's Encrypt sends expiry warnings. A real mailbox somebody reads:
# it is how you find out a renewal has been failing for a fortnight.
ACME_EMAIL=you@example.com                                 # CHANGE ME

# Must include DOMAIN. Django refuses a Host header not in this list.
DJANGO_ALLOWED_HOSTS=pos.example.co.ke                     # CHANGE ME
DJANGO_CSRF_TRUSTED_ORIGINS=https://pos.example.co.ke      # CHANGE ME

# ---------------------------------------------------------------------------
# Secrets
# ---------------------------------------------------------------------------
#
# Generate each of these fresh. Never reuse a development value, and never let
# one reach a terminal history you keep:
#
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
#
# For DARAJA_ENCRYPTION_KEY specifically, which must be a Fernet key:
#
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

DJANGO_SECRET_KEY=                                         # CHANGE ME
DJANGO_DEBUG=False

POSTGRES_USER=pos_admin
POSTGRES_PASSWORD=                                         # CHANGE ME
POSTGRES_DB=pos

# The role Django connects as. Deliberately not the superuser: tenant isolation
# depends on this role being NOSUPERUSER and NOBYPASSRLS, so that Row-Level
# Security actually applies to it.
DB_NAME=pos
DB_USER=pos_app
DB_PASSWORD=                                               # CHANGE ME
DB_HOST=db
DB_PORT=5432

REDIS_PASSWORD=                                            # CHANGE ME

# Encrypts each tenant's Daraja credentials at rest. Separate from SECRET_KEY
# on purpose: rotating a session key should not decrypt-and-lose every shop's
# M-Pesa credentials.
#
# **Losing this means losing every stored credential.** Back it up somewhere
# that is not this server.
DARAJA_ENCRYPTION_KEY=                                     # CHANGE ME

# ---------------------------------------------------------------------------
# The proxy in front
# ---------------------------------------------------------------------------
#
# How many trusted proxies sit between the internet and Django. The M-Pesa IP
# allowlist reads the *last* X-Forwarded-For entry and trusts it, so this
# number has to match reality exactly.
#
#   1  = Caddy only, which is what this compose file builds.
#   2  = a CDN or cloud load balancer in front of Caddy.
#
# Getting it wrong in one direction lets the allowlist be spoofed; in the
# other, it blocks Safaricom entirely. DEPLOYMENT.md has a forged-header check
# that proves the value against the running deployment - run it after any
# change to what sits in front.
TRUSTED_PROXY_HOPS=1

# ---------------------------------------------------------------------------
# The platform console
# ---------------------------------------------------------------------------
#
# The admin path. The application refuses to start on the published default
# (pos.E001), because a guessable admin path behind which tenant isolation is
# lifted is the single worst thing to leave at its default.
PLATFORM_ADMIN_URL=                                        # CHANGE ME - e.g. "ops-7f3a9c/"

PLATFORM_ADMIN_USERNAME=platform
PLATFORM_ADMIN_PASSWORD=                                   # CHANGE ME
PLATFORM_ADMIN_EMAIL=you@example.com                       # CHANGE ME

# ---------------------------------------------------------------------------
# M-Pesa
# ---------------------------------------------------------------------------
#
# Where Safaricom sends callbacks. Must be the public HTTPS URL, and must
# resolve from outside - a callback Safaricom cannot reach is a payment that
# reconciliation has to find later.
MPESA_CALLBACK_BASE_URL=https://pos.example.co.ke          # CHANGE ME

# Per-tenant Daraja credentials are entered through the platform console and
# encrypted at rest. They are not environment variables.

# ---------------------------------------------------------------------------
# Tuning
# ---------------------------------------------------------------------------

DJANGO_SETTINGS_MODULE=config.settings.production
GUNICORN_WORKERS=4
DJANGO_LOG_LEVEL=INFO

PIN_LOCKOUT_MAX_ATTEMPTS=5
PIN_LOCKOUT_SECONDS=900

JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=30

# A measured line coming to less than this is flagged for a person. See
# ARCHITECTURE.md - it is a tripwire, not a control.
SUSPICIOUS_QUANTITY_FLOOR_CENTS=2000

BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=4
BACKUP_HOUR=2

<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- Debug builds only. Android 9+ blocks plain HTTP, and a development
         backend on a laptop has no certificate, so a physical phone would fail
         every request with a cleartext error that looks like the server being
         down. res/xml/network_security_config.xml names the development hosts
         and nothing else; release builds never merge this file and keep
         refusing cleartext everywhere. -->
    <application
        android:networkSecurityConfig="@xml/network_security_config"
        tools:replace="android:networkSecurityConfig"/>
</manifest>
